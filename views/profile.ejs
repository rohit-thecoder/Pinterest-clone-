<%- include('./partials/header.ejs') %>

<div class="full w-full min-h-screen bg-zinc-800 text-white pt-1">
    <form hidden id="uploadform" action="/fileupload" method="post" enctype="multipart/form-data">
        <input type="file" name="image">
    </form>
  <div class="profdets flex flex-col items-center mt-20">
    <div class="relative">
        <span id="uploadicon" class="w-8 h-8 absolute bottom-0 right-0 rounded-full flex items-center justify-center bg-zinc-200 "><i class="ri-pencil-fill text-zinc-800"></i></span>
        <div class="w-32 h-32 bg-zinc-200 rounded-full overflow-hidden">
        <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profileImage%>" alt="">
    </div>
    </div>
    <h1 class="text-3xl font-semibold mt-5"><%=user.name  %></h1>
    <h3 class="text-md mt-1">@<%=user.username  %></h3>
    <div class="flex items-center gap-4 mt-6">
  <a
    href="/edit"
    class="px-7 py-2 bg-zinc-700 text-white rounded-full text-sm font-semibold hover:bg-zinc-600 transition"
  >
    Edit
  </a>

  <a href="/add"
    class="px-6 py-2 bg-red-600 text-white rounded-full text-sm font-semibold hover:bg-red-700 transition cursor-pointer"
  >
    Create Post
</a>
</div>

    
  </div>
  <div class="cards flex flex-wrap gap-10 px-10 mt-10">
    <div class="cards">
      <<% if (user.posts.length > 0) { %>
  <div class="w-52 h-44 bg-zinc-200 rounded-lg overflow-hidden">
    <img class="w-full h-full object-cover" src="/images/uploads/<%= user.posts[0].image %>" alt="Post Image">
  </div>
  <a href="/show/posts" class=" inline-block text-xl font-semibold mt-3 hover:text-zinc-300">Your Uploaded Pins</a>
  <h5 class="text-sm font-medium opacity-50"><%= user.posts.length %> pins</h5>
<% } else { %>
  <h3 class="text-xl font-semibold mt-3 opacity-70">No Pins Uploaded Yet</h3>
  <p class="text-sm opacity-50">Start creating your first post!</p>
<% } %>

  </div>
</div>

<script>
    document.querySelector("#uploadicon").addEventListener("click", function(){
         document.querySelector("#uploadform input").click()
    })
    document.querySelector("#uploadform input").addEventListener("change", function(){
        document.querySelector("#uploadform").submit();
    })
</script>

<%- include('./partials/footer.ejs') %>
