<%- include('./partials/header.ejs') %>

<div class="w-full min-h-screen bg-zinc-800 pt-24 px-10 py-8 text-white">
  <div class="cards flex flex-wrap gap-10">
    <% user.posts.forEach(function(elem){ %>
    <div class="w-32">
      <div class="w-full h-40 bg-zinc-700 rounded-lg overflow-hidden">
        <img class="w-full h-full object-contain" src="/images/uploads/<%=elem.image %>" alt="" />
      </div>
      <h5 class="mt-2 text-sm"><%=elem.title  %></h5>
    </div>
    <% }) %>
  </div>
</div>

<%- include('./partials/footer.ejs') %>
