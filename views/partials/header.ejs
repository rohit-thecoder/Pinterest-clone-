<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pinterest</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/Pinterest/public/stylesheets/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <% if (nav == true) { %>
<nav
  class="w-full px-6 md:px-16 py-4 flex items-center justify-between bg-zinc-800 text-white fixed top-0 left-0 shadow-md z-50"
>
  <!-- Logo -->
  <a href="/profile" class="text-2xl font-bold tracking-tight">Pinterest</a>

  <!-- Desktop Menu -->
  <div class="hidden md:flex items-center gap-6 text-sm font-medium">
    <a class="hover:text-red-400 transition" href="/profile">Profile</a>
    <a class="hover:text-red-400 transition" href="/feed">Feed</a>
    <a
      class="px-4 py-2 bg-red-600 rounded-full hover:bg-red-700 transition"
      href="/"
    >
      Logout
    </a>
  </div>

  <!-- Hamburger Icon Mobile -->
  <button id="menu-btn" class="md:hidden text-3xl">
    <i class="ri-menu-line"></i>
  </button>
</nav>

<!-- MOBILE MENU -->
<div
  id="mobile-menu"
  class="hidden flex-col bg-zinc-900 text-white px-6 py-4 space-y-4 md:hidden fixed top-16 left-0 w-full shadow-lg z-40"
>
  <a class="hover:text-red-400 transition" href="/profile">Profile</a>
  <a class="hover:text-red-400 transition" href="/feed">Feed</a>
  <a
    class="px-4 py-2 bg-red-600 rounded-full w-fit hover:bg-red-700 transition"
    href="/"
  >
    Logout
  </a>
</div>
<% } %>

<!-- Hamburger Script -->
<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn.addEventListener("click", () => {
    menu.classList.toggle("hidden");
  });
</script>
