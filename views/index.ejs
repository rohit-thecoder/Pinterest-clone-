<%- include('./partials/header.ejs') %>

<div class="w-full min-h-screen bg-center bg-cover bg-[url(https://images.unsplash.com/photo-1578301978018-3005759f48f7?q=80&w=2044&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D)] 
    flex items-center justify-center px-4 py-10">

    <div class="w-full sm:w-[80vw] md:w-[60vw] lg:w-[35vw] bg-white px-6 sm:px-10 md:px-14 py-10 rounded-[20px] sm:rounded-[30px]">

        <h1 class="text-2xl sm:text-3xl text-center font-semibold text-zinc-700 leading-none mb-7">
            Welcome to <span class="text-red-600">Pinterest</span> <span><i class="ri-pinterest-fill text-red-600 "></i></span>
        </h1>

        <form action="/login" method="post">
            <h5 class="text-zinc-600 px-1 sm:px-2 text-sm sm:text-base">Enter Your Username</h5>
            <input class="border-2 rounded-full border-zinc-300 mt-1 w-full px-3 py-2 mb-3 text-sm sm:text-base" 
                   type="text" name="username" placeholder="username">

            <h5 class="text-zinc-600 px-1 sm:px-2 text-sm sm:text-base">Enter Password</h5>
            <input class="border-2 rounded-full border-zinc-300 mt-1 w-full px-3 py-2 mb-2 text-sm sm:text-base"
                   type="password" name="password" placeholder="password">

            <a class="font-semibold text-zinc-500 inline-block mb-2 px-1 sm:px-2 text-sm hover:text-zinc-600" href="/forgot-password">
                Forgot password?
            </a>

            <input class="border-2 mt-3 w-full px-3 py-2 bg-red-600 text-white rounded-full hover:bg-red-700 cursor-pointer text-sm sm:text-base" 
                   type="submit" value="Login">

            <p class="text-xs sm:text-sm font-semibold text-zinc-700 w-full sm:w-3/4 mt-5 mx-auto text-center">
                Lorem ipsum dolor sit amet, consectetur adipisicing elit. Eveniet inventore alias! Laudantium!
            </p>
        </form>
        <a class="inline-block mt-4 text-m font-semibold text-red-600 text-center w-full" href="/register">Don't have an account?</a>
    </div>
</div>

<%- include('./partials/footer.ejs') %>
