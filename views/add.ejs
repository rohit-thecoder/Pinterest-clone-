<%- include('./partials/header.ejs') %>
    <div class="w-full min-h-screen bg-zinc-800 px-10 py-5  pt-24">
        <h1 class="text-xl text-white">Create new Post</h1>
        <hr class="opacity-10 mt-5">
        <form action="/createpost" method="post" enctype="multipart/form-data">
            <input class="block w-1/3 px-3 py-2 bg-white text-zinc-800" type="file" name="postimage">
            <input class="block w-1/3 px-3 py-2 border-2 mt-2 rounded-md bg-white text-zinc-800" type="text" placeholder="Title" name="title">
            <textarea class="block w-1/3 px-3 py-2 border-2 mt-2 rounded-md bg-white text-zinc-800" type="text" placeholder="Description " name="description"> </textarea>
            <input class="block w-1/3 px-3 py-2 mt-2 rounded-md bg-red-600 text-white" type="submit" value="Create Post">
        </form>
    </div>
<%- include('./partials/footer.ejs') %>
